{
  "name": "random-player-exe",
  "productName": "随机播放器",
  "version": "5.8.1",
  "description": "随机播放器 EXE 版 — 便携本地视频随机播放器（数据随行，免授权）",
  "main": "main/main.js",
  "author": "Random Player",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "tailwind": "tailwindcss -c tailwind.config.js -i renderer/styles.src.css -o renderer/styles.css --minify",
    "build": "npm run tailwind",
    "test:core": "node tools/core-tests.js",
    "test:e2e": "node tools/run-tests.js",
    "test:5.4": "node tools/run-v5_4-tests.js",
    "test:5.5": "node tools/run-v5_5-tests.js",
    "test:5.6": "node tools/run-v5_6-tests.js",
    "test:5.7": "node tools/run-v5_7-tests.js",
    "test:5.8": "node tools/run-v5_8-tests.js",
    "test": "npm run test:core && npm run test:e2e",
    "prepack": "node tools/backup-unpacked-data.js",
    "pack": "npm run build && electron-builder --win zip",
    "postpack": "node tools/restore-unpacked-data.js",
    "predist": "node tools/backup-unpacked-data.js",
    "dist": "npm run build && electron-builder --win",
    "postdist": "node tools/restore-unpacked-data.js"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "tailwindcss": "3.4.17"
  },
  "build": {
    "appId": "com.randomplayer.app",
    "productName": "随机播放器",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "normal"
  }
}
