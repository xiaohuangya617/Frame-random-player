{
  "name": "random-player-exe",
  "productName": "随机播放器",
  "version": "5.2.0",
  "description": "随机播放器 EXE 版 — 便携本地视频随机播放器（数据随行，免授权）",
  "main": "main/main.js",
  "author": "Random Player",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "tailwind": "tailwindcss -c tailwind.config.js -i renderer/styles.src.css -o renderer/styles.css --minify",
    "build": "npm run tailwind",
    "prepack": "node tools/backup-unpacked-data.js",
    "pack": "npm run build && electron-builder --win zip",
    "postpack": "node tools/restore-unpacked-data.js",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.randomplayer.app",
    "productName": "随机播放器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "normal"
  }
}
